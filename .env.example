# Copy to .env (gitignored) and fill in. Load with: uv run --env-file .env ...
ANTHROPIC_API_KEY=
EXTRACT_MODEL=anthropic:claude-haiku-5-5
QUERY_MODEL=anthropic:claude-haiku-5-5
ANSWER_MODEL=anthropic:claude-haiku-5-5
DATABASE_URL=postgresql://mem:mem@localhost:5432/mem
API_KEY=change-me
MEMORY_USER_ID=me
# Optional. Reranking weights (ADR 0016): defaults shown.
# RANK_IMPORTANCE_WEIGHT=0.5
# RANK_HALF_LIFE_DAYS=365
# Optional. Export traces and metrics (ADR 0018); prices are USD per million tokens, for llm.cost.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
# Evaluation only: the judge model (ADR 0015).
# JUDGE_MODEL=anthropic:claude-sonnet-5-5
